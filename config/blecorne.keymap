// Miryoku uses 36 keys: the 3x5 grid on each half plus the 3 thumb keys.
// The outer columns of the 6-column Corne are left as &none.
// Options (alphas, clipboard, nav style...) live in config/miryoku/custom_config.h.

#include "miryoku/custom_config.h"
#include "miryoku/mapping/42/corne.h"
#include "miryoku/miryoku.dtsi"

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
    };
};
